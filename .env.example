# PredictMedix - Environment Configuration Example
# Copy this file to '.env' and fill in your values.

# Flask Application Key
SECRET_KEY=your-super-secret-key-change-this

# MongoDB Connection URI
# Local MongoDB: mongodb://localhost:27017/insurance_auth
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/insurance_auth
MONGO_URI=mongodb://localhost:27017/insurance_auth

# Flask-Mail Configuration (for password reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Server Port
PORT=5000
